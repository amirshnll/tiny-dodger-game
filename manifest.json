{
  "manifest_version": 3,
  "name": "Tiny Dodger",
  "version": "1.0.0",
  "description": "A tiny multilingual arcade dodging game.",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tiny-dodger@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Tiny Dodger",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "image/icon-16.png",
      "32": "image/icon-32.png",
      "48": "image/icon-48.png",
      "128": "image/icon-128.png"
    }
  },
  "icons": {
    "16": "image/icon-16.png",
    "32": "image/icon-32.png",
    "48": "image/icon-48.png",
    "128": "image/icon-128.png"
  }
}